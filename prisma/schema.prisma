// Dental Hospital Management System - Database Schema
// Multi-Tenant SaaS Architecture

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ==================== MULTI-TENANCY ====================

model Hospital {
  id                  String    @id @default(cuid())
  name                String
  slug                String    @unique
  email               String    @unique
  phone               String?
  alternatePhone      String?
  address             String?   @db.Text
  city                String?
  state               String?
  pincode             String?
  logo                String?
  registrationNo      String?
  gstNumber           String?
  panNumber           String?
  website             String?
  tagline             String?

  // Localization. Defaults target Egyptian clinics (Arabic-first).
  // `country` will select the tax provider — see docs/LOCALIZATION.md.
  locale              String    @default("ar-EG")
  country             String    @default("EG")
  currency            String    @default("EGP")
  timezone            String    @default("Africa/Cairo")

  plan                Plan      @default(FREE)
  planExpiresAt       DateTime?
  patientLimit        Int       @default(100)
  staffLimit          Int       @default(3)
  storageLimitMb      Int       @default(500)

  isActive            Boolean   @default(true)
  onboardingCompleted Boolean   @default(false)

  emailVerificationToken  String?
  emailVerificationExpiry DateTime?

  workingHours        String?   @db.Text
  bankName            String?
  bankAccountNo       String?
  bankAccountName     String?
  bankIfsc            String?
  upiId               String?

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  users               User[]
  staff               Staff[]
  patients            Patient[]
  appointments        Appointment[]
  treatments          Treatment[]
  treatmentPlans      TreatmentPlan[]
  dentalChartEntries  DentalChartEntry[]
  prescriptions       Prescription[]
  procedures          Procedure[]
  medications         Medication[]
  invoices            Invoice[]
  payments            Payment[]
  insuranceClaims     InsuranceClaim[]
  inventoryCategories InventoryCategory[]
  inventoryItems      InventoryItem[]
  inventoryBatches    InventoryBatch[]
  stockTransactions   StockTransaction[]
  stockAlerts         StockAlert[]
  suppliers           Supplier[]
  purchaseOrders      PurchaseOrder[]
  labVendors          LabVendor[]
  labOrders           LabOrder[]
  documents           Document[]
  notifications       Notification[]
  auditLogs           AuditLog[]
  settings            Setting[]
  holidays            Holiday[]
  communicationTemplates CommunicationTemplate[]
  smsLogs             SMSLog[]
  emailLogs           EmailLog[]
  surveys             Survey[]
  bulkCommunications  BulkCommunication[]
  marketingAutomations MarketingAutomation[]
  staffInvites        StaffInvite[]
  subscription        Subscription?
  attendance          Attendance[]
  staffShifts         StaffShift[]
  leaves              Leave[]
  rooms               Room[]
  appointmentReminders AppointmentReminder[]
  doctorBreaks        DoctorBreak[]
  blockedSlots        BlockedSlot[]
  messageQueue        MessageQueue[]
  aiConversations     AIConversation[]
  aiSkillExecutions   AISkillExecution[]
  aiInsights          AIInsight[]
  patientRiskScores   PatientRiskScore[]
  patientPortalEnabled Boolean   @default(false)

  paymentGatewayConfig PaymentGatewayConfig?
  paymentLinks        PaymentLink[]
  patientOTPs         PatientOTP[]
  formTemplates       FormTemplate[]
  formSubmissions     FormSubmission[]
  insuranceProviders  InsuranceProviderMaster[]
  patientInsurances   PatientInsurance[]
  preAuthorizations   PreAuthorization[]
  membershipPlans     MembershipPlan[]
  patientMemberships  PatientMembership[]
  referrals           Referral[]
  loyaltyTransactions LoyaltyTransaction[]
  calendarIntegrations CalendarIntegration[]
  waitlistEntries     Waitlist[]
  paymentPlans        PaymentPlan[]
  videoConsultations  VideoConsultation[]
  instruments         Instrument[]
  sterilizationLogs   SterilizationLog[]
  devices             Device[]
  pushDevices         PushDevice[]
  dataImportJobs      DataImportJob[]
  imagingStudies    ImagingStudy[]
  aiAnalysisJobs    AIAnalysisJob[]

  @@index([slug])
  @@index([plan])
  @@index([isActive])
}

enum Plan {
  FREE
  PROFESSIONAL
  ENTERPRISE
  SELF_HOSTED
}

// ==================== SUBSCRIPTION & BILLING ====================

model Subscription {
  id                     String             @id @default(cuid())
  hospitalId             String             @unique
  // Plan tiers reuse the existing Plan enum (FREE/PROFESSIONAL/ENTERPRISE/
  // SELF_HOSTED) - deliberately NOT a new enum: this column predates Phase 9
  // and changing its value set would be destructive to existing rows.
  plan                   Plan
  // Status lifecycle (Phase 9 licensing): TRIAL/ACTIVE run normally,
  // GRACE_PERIOD stays usable after period end, EXPIRED/SUSPENDED/CANCELLED
  // hard-block the tenant. Legacy PAST_DUE/TRIALING values remain for rows
  // created before Phase 9.
  status                 SubscriptionStatus @default(TRIAL)
  currentPeriodStart     DateTime
  currentPeriodEnd       DateTime
  cancelledAt            DateTime?
  paymentProvider        String?
  externalSubscriptionId String?

  // Phase 9 licensing management
  gracePeriodDays        Int                @default(3)
  autoRenew              Boolean            @default(false)
  notes                  String?            @db.Text
  managedBy              String?

  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  hospital               Hospital           @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  payments               SubscriptionPayment[]
  auditLogs              LicenseAuditLog[]

  @@index([status])
  @@index([currentPeriodEnd])
}

model LicenseAuditLog {
  id             String             @id @default(cuid())
  subscriptionId String
  subscription   Subscription       @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  action         String // CREATED, RENEWED, SUSPENDED, REACTIVATED, EXPIRED, GRACE_STARTED, STATUS_CHANGED_TO_*, UPDATED
  previousStatus SubscriptionStatus?
  newStatus      SubscriptionStatus
  performedBy    String? // userId; null = system (cron/seed)
  notes          String?            @db.Text
  metadata       Json?
  createdAt      DateTime           @default(now())

  @@index([subscriptionId])
  @@index([createdAt])
}

model SubscriptionPayment {
  id                String                    @id @default(cuid())
  subscriptionId    String
  amount            Decimal                   @db.Decimal(10, 2)
  currency          String                    @default("EGP")
  status            SubscriptionPaymentStatus @default(PENDING)
  paymentMethod     String?
  externalPaymentId String?
  invoiceUrl        String?
  paidAt            DateTime?
  createdAt         DateTime                  @default(now())

  subscription      Subscription              @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
  TRIALING
  // Phase 9 licensing statuses
  TRIAL
  GRACE_PERIOD
  SUSPENDED
}

enum SubscriptionPaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

// ==================== AUTHENTICATION & USERS ====================

model User {
  id              String    @id @default(cuid())
  // Nullable on purpose: the platform-level SUPER_ADMIN (licensing/subscription
  // management, Phase 9) belongs to no hospital. All other roles stay scoped.
  hospitalId      String?
  email           String    @unique
  password        String
  name            String
  phone           String?
  role            Role      @default(RECEPTIONIST)
  isActive        Boolean   @default(true)
  isHospitalAdmin Boolean   @default(false)
  emailVerified   DateTime?
  image           String?
  mustChangePassword Boolean @default(false)

  // Personal locale override, BCP 47. NULL means "inherit from the clinic" and
  // is deliberately NOT defaulted: a default would be indistinguishable from an
  // explicit choice of a locale, so a clinic changing its own locale would
  // silently fail to propagate to every staff member who never expressed a
  // preference. See docs/LOCALIZATION.md.
  locale          String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  hospital        Hospital? @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  staff           Staff?
  auditLogs       AuditLog[]
  invoicesCreated Invoice[]           // Phase 12
  paymentsRecorded Payment[]          // Phase 12
  notifications   Notification[]
  sessions        Session[]
  accounts        Account[]
  aiConversations AIConversation[]
  calendarIntegrations CalendarIntegration[]
  pushDevices     PushDevice[]
  dataImportJobs  DataImportJob[]
  acknowledgedStockAlerts StockAlert[]
  labOrderStatusChanges   LabOrderHistory[]
  uploadedLabOrderDocuments LabOrderDocument[]
  portalPatient         Patient?         // Phase 13 — linked portal account (role PATIENT)
  imagingStudiesUploaded ImagingStudy[]   // Phase 19A
  aiAnalysisJobsRequested AIAnalysisJob[] // Phase 19A
  aiAnalysisJobsReviewed  AIAnalysisJob[] // Phase 19A (reviewedById)

  @@index([email])
  @@index([role])
  @@index([hospitalId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum Role {
  SUPER_ADMIN
  ADMIN
  DOCTOR
  RECEPTIONIST
  LAB_TECH
  ACCOUNTANT
  // Phase 13 — portal-linked patient accounts (see D2). Portal sessions
  // themselves ride the OTP/JWT cookie (lib/patient-auth.ts); this role
  // models the linked User record and keeps such users out of staff routes.
  PATIENT
}

// ==================== STAFF INVITES ====================

model StaffInvite {
  id          String            @id @default(cuid())
  hospitalId  String
  email       String
  name        String?
  phone       String?
  role        Role
  invitedBy   String
  token       String            @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  status      StaffInviteStatus @default(PENDING)
  createdAt   DateTime          @default(now())

  hospital    Hospital          @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@index([hospitalId])
  @@index([email])
  @@index([token])
  @@index([status])
}

enum StaffInviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  CANCELLED
}

// ==================== STAFF MANAGEMENT ====================

model Staff {
  id              String    @id @default(cuid())
  hospitalId      String
  userId          String    @unique
  employeeId      String
  firstName       String
  lastName        String
  dateOfBirth     DateTime?
  gender          Gender?
  phone           String
  alternatePhone  String?
  email           String
  address         String?   @db.Text
  city            String?
  state           String?
  pincode         String?
  aadharNumber    String?
  panNumber       String?
  qualification   String?
  specialization  String?
  licenseNumber   String?
  joiningDate     DateTime  @default(now())
  salary          Decimal?  @db.Decimal(10, 2)
  bankAccountNo   String?
  bankIfsc        String?
  emergencyContact String?
  emergencyPhone  String?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  hospital        Hospital  @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointments    Appointment[] @relation("DoctorAppointments")
  treatments      Treatment[]
  prescriptions   Prescription[]
  treatmentPlans  TreatmentPlan[]   @relation("DoctorTreatmentPlans")
  clinicalNotes   ClinicalNote[]    @relation("DoctorClinicalNotes")
  attendance      Attendance[]
  shifts          StaffShift[]
  breaks            DoctorBreak[]
  blockedSlots      BlockedSlot[]
  leaves          Leave[]
  videoConsultations VideoConsultation[] @relation("DoctorVideoConsultations")

  @@unique([hospitalId, employeeId])
  @@index([hospitalId])
  @@index([phone])
}

model Attendance {
  id          String           @id @default(cuid())
  hospitalId  String
  staffId     String
  date        DateTime         @db.Date
  clockIn     DateTime?
  clockOut    DateTime?
  status      AttendanceStatus @default(PRESENT)
  notes       String?
  createdAt   DateTime         @default(now())

  hospital    Hospital         @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  staff       Staff            @relation(fields: [staffId], references: [id])

  @@unique([staffId, date])
  @@index([hospitalId])
  @@index([date])
}

model StaffShift {
  id          String    @id @default(cuid())
  hospitalId  String
  staffId     String
  dayOfWeek   Int
  startTime   String
  endTime     String
  isActive    Boolean   @default(true)

  hospital    Hospital  @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  staff       Staff     @relation(fields: [staffId], references: [id])

  @@unique([staffId, dayOfWeek])
  @@index([hospitalId])
}

model Leave {
  id          String      @id @default(cuid())
  hospitalId  String
  staffId     String
  leaveType   LeaveType
  startDate   DateTime    @db.Date
  endDate     DateTime    @db.Date
  reason      String?
  status      LeaveStatus @default(PENDING)
  approvedBy  String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  hospital    Hospital    @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  staff       Staff       @relation(fields: [staffId], references: [id])

  @@index([hospitalId])
  @@index([staffId])
  @@index([startDate, endDate])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  LATE
  ON_LEAVE
}

enum LeaveType {
  CASUAL
  SICK
  EARNED
  UNPAID
  MATERNITY
  PATERNITY
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

// ==================== PATIENT MANAGEMENT ====================

model Patient {
  id              String     @id @default(cuid())
  hospitalId      String
  patientId       String
  firstName       String
  lastName        String
  dateOfBirth     DateTime?
  age             Int?
  gender          Gender?
  bloodGroup      BloodGroup?
  phone           String
  alternatePhone  String?
  email           String?
  address         String?    @db.Text
  city            String?
  state           String?    @default("القاهرة")
  pincode         String?
  aadharNumber    String?
  occupation      String?
  referredBy      String?

  emergencyContactName     String?
  emergencyContactPhone    String?
  emergencyContactRelation String?

  // Locale override for the patient portal. NULL means "inherit from the
  // clinic" — same reasoning as User.locale above.
  locale          String?

  // Phase 13 — portal account linking. portalUserId points at the PATIENT-role
  // User created by /api/portal/accounts (password login); the OTP flow works
  // without it. NULL = portal not enabled for this patient.
  portalUserId    String?  @unique
  portalEnabled   Boolean  @default(false)

  aiSummary       Json?
  aiSummaryAt     DateTime?

  portalUser      User?    @relation("PatientPortalUser", fields: [portalUserId], references: [id], onDelete: SetNull)

  isActive        Boolean    @default(true)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  hospital        Hospital   @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  medicalHistory  MedicalHistory?
  appointments    Appointment[]
  treatments      Treatment[]
  treatmentPlans  TreatmentPlan[]
  dentalChart     DentalChartEntry[]
  prescriptions   Prescription[]
  clinicalNotes   ClinicalNote[]
  invoices        Invoice[]
  documents       Document[]
  queuedMessages  MessageQueue[]
  labOrders       LabOrder[]
  riskScores      PatientRiskScore[]
  insurancePolicies PatientInsurance[]
  insuranceClaims InsuranceClaim[]
  preAuthorizations PreAuthorization[]
  memberships     PatientMembership[]
  paymentPlans    PaymentPlan[]
  invoicePayments Payment[]           @relation("PatientInvoicePayments") // Phase 12
  videoConsultations VideoConsultation[]
  imagingStudies   ImagingStudy[]  // Phase 19A

  @@unique([hospitalId, patientId])
  @@index([hospitalId])
  @@index([phone])
  @@index([firstName, lastName])
}

model MedicalHistory {
  id                String    @id @default(cuid())
  patientId         String    @unique

  hasAllergies      Boolean   @default(false)
  drugAllergies     String?   @db.Text
  foodAllergies     String?
  materialAllergies String?

  hasDiabetes       Boolean   @default(false)
  diabetesType      String?
  hasHypertension   Boolean   @default(false)
  hasHeartDisease   Boolean   @default(false)
  heartCondition    String?
  hasBleedingDisorder Boolean @default(false)
  hasAsthma         Boolean   @default(false)
  hasThyroid        Boolean   @default(false)
  thyroidType       String?
  hasHepatitis      Boolean   @default(false)
  hepatitisType     String?
  hasHiv            Boolean   @default(false)
  hasEpilepsy       Boolean   @default(false)
  isPregnant        Boolean   @default(false)
  pregnancyWeeks    Int?
  otherConditions   String?   @db.Text

  currentMedications String?  @db.Text

  previousDentalWork String?  @db.Text
  lastDentalVisit   DateTime?
  dentalAnxietyLevel Int?     @default(0)

  familyDentalHistory String? @db.Text

  smokingStatus     SmokingStatus @default(NEVER)
  alcoholConsumption AlcoholConsumption @default(NEVER)
  tobaccoChewing    Boolean   @default(false)

  additionalNotes   String?   @db.Text

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  patient           Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum BloodGroup {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
}

enum SmokingStatus {
  NEVER
  FORMER
  CURRENT
  OCCASIONAL
}

enum AlcoholConsumption {
  NEVER
  OCCASIONAL
  MODERATE
  HEAVY
}

// ==================== APPOINTMENT SCHEDULING ====================

model Appointment {
  id              String            @id @default(cuid())
  hospitalId      String
  appointmentNo   String
  patientId       String
  doctorId        String

  scheduledDate   DateTime          @db.Date
  scheduledTime   String
  duration        Int               @default(30)
  chairNumber     Int?
  roomId          String?
  recurrenceGroupId String?
  contactPhone    String?

  appointmentType AppointmentType   @default(CONSULTATION)
  status          AppointmentStatus @default(SCHEDULED)
  priority        Priority          @default(NORMAL)

  checkedInAt     DateTime?
  checkedOutAt    DateTime?
  waitTime        Int?

  chiefComplaint  String?           @db.Text
  notes           String?           @db.Text

  cancelledAt     DateTime?
  cancellationReason String?

  isVirtual       Boolean           @default(false)
  videoConsultationId String?

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  hospital        Hospital          @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  patient         Patient           @relation(fields: [patientId], references: [id])
  doctor          Staff             @relation("DoctorAppointments", fields: [doctorId], references: [id])
  treatments      Treatment[]
  // Phase 11 — clinical workflow links.
  treatmentPlans  TreatmentPlan[]   @relation("AppointmentTreatmentPlans")
  invoices        Invoice[]         // Phase 12
  prescriptions   Prescription[]    @relation("AppointmentPrescriptions")
  clinicalNotes   ClinicalNote[]
  reminders       AppointmentReminder[]
  videoConsultation VideoConsultation?
  room            Room?             @relation(fields: [roomId], references: [id])
  queuedMessages  MessageQueue[]
  imagingStudies  ImagingStudy[]   // Phase 19A

  @@unique([hospitalId, appointmentNo])
  @@index([roomId])
  @@index([recurrenceGroupId])
  @@index([hospitalId])
  @@index([scheduledDate])
  @@index([patientId])
  @@index([doctorId])
  @@index([status])
}

model AppointmentReminder {
  id              String         @id @default(cuid())
  hospitalId      String?
  appointmentId   String
  reminderType    ReminderType
  scheduledFor    DateTime
  sentAt          DateTime?
  status          ReminderStatus @default(PENDING)
  createdAt       DateTime       @default(now())

  appointment     Appointment    @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  hospital        Hospital?      @relation(fields: [hospitalId], references: [id])

  @@index([scheduledFor])
  @@index([status])
  @@index([hospitalId])
}

enum AppointmentType {
  CONSULTATION
  PROCEDURE
  FOLLOW_UP
  EMERGENCY
  CHECK_UP
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
  RESCHEDULED
}

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum ReminderType {
  SMS
  EMAIL
  WHATSAPP
}

enum ReminderStatus {
  PENDING
  SENT
  FAILED
  CANCELLED
}

// ==================== DENTAL CHART ====================

model DentalChartEntry {
  id              String         @id @default(cuid())
  hospitalId      String
  patientId       String
  toothNumber     Int
  toothNotation   String

  mesial          Boolean        @default(false)
  distal          Boolean        @default(false)
  occlusal        Boolean        @default(false)
  buccal          Boolean        @default(false)
  lingual         Boolean        @default(false)

  condition       ToothCondition
  severity        Severity       @default(MILD)

  notes           String?
  diagnosedDate   DateTime       @default(now())
  resolvedDate    DateTime?

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  hospital        Hospital       @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  patient         Patient        @relation(fields: [patientId], references: [id])

  @@index([hospitalId])
  @@index([patientId])
  @@index([toothNumber])
}

enum ToothCondition {
  HEALTHY
  CARIES
  FILLED
  CROWN
  BRIDGE
  IMPLANT
  ROOT_CANAL
  EXTRACTION
  MISSING
  FRACTURED
  SENSITIVE
  MOBILITY
  ABSCESS
  PERIODONTAL
}

enum Severity {
  MILD
  MODERATE
  SEVERE
}

// ==================== TREATMENT & CLINICAL ====================

model Procedure {
  id              String            @id @default(cuid())
  hospitalId      String
  code            String
  name            String
  category        ProcedureCategory
  description     String?           @db.Text
  defaultDuration Int               @default(30)
  basePrice       Decimal           @db.Decimal(10, 2)

  materials       String?           @db.Text

  preInstructions String?           @db.Text
  postInstructions String?          @db.Text

  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  hospital        Hospital          @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  treatments      Treatment[]
  treatmentPlanItems TreatmentPlanItem[]

  @@unique([hospitalId, code])
  @@index([hospitalId])
  @@index([category])
}

enum ProcedureCategory {
  PREVENTIVE
  RESTORATIVE
  ENDODONTIC
  PERIODONTIC
  PROSTHODONTIC
  ORTHODONTIC
  ORAL_SURGERY
  COSMETIC
  DIAGNOSTIC
  EMERGENCY
}

model TreatmentPlan {
  id              String              @id @default(cuid())
  hospitalId      String
  planNumber      String
  patientId       String

  title           String
  description     String?             @db.Text
  status          TreatmentPlanStatus @default(DRAFT)

  estimatedCost   Decimal             @db.Decimal(10, 2)
  estimatedDuration Int?

  startDate       DateTime?
  expectedEndDate DateTime?
  completedDate   DateTime?

  consentGiven    Boolean             @default(false)
  consentDate     DateTime?

  notes           String?             @db.Text

  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  // Phase 11 — clinical workflow: plan ownership + appointment link.
  doctorId        String?
  chiefComplaint  String?             @db.Text
  diagnosis       String?             @db.Text
  currency        String              @default("EGP")
  appointmentId   String?

  doctor          Staff?              @relation("DoctorTreatmentPlans", fields: [doctorId], references: [id])
  appointment     Appointment?        @relation("AppointmentTreatmentPlans", fields: [appointmentId], references: [id])
  invoices        Invoice[]           // Phase 12
  prescriptions   Prescription[]
  clinicalNotes   ClinicalNote[]

  hospital        Hospital            @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  patient         Patient             @relation(fields: [patientId], references: [id])
  items           TreatmentPlanItem[]

  @@unique([hospitalId, planNumber])
  @@index([hospitalId])
  @@index([patientId])
  @@index([status])
  @@index([doctorId])
  @@index([appointmentId])
}

model TreatmentPlanItem {
  id              String                  @id @default(cuid())
  treatmentPlanId String
  procedureId     String

  toothNumbers    String?
  priority        Int                     @default(1)
  estimatedCost   Decimal                 @db.Decimal(10, 2)
  status          TreatmentPlanItemStatus @default(PENDING)

  notes           String?

  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  treatmentPlan   TreatmentPlan           @relation(fields: [treatmentPlanId], references: [id], onDelete: Cascade)
  procedure       Procedure               @relation(fields: [procedureId], references: [id])

  @@index([treatmentPlanId])
}

enum TreatmentPlanStatus {
  DRAFT
  PROPOSED
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TreatmentPlanItemStatus {
  PENDING
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Treatment {
  id              String          @id @default(cuid())
  hospitalId      String
  treatmentNo     String
  patientId       String
  appointmentId   String?
  procedureId     String
  doctorId        String

  toothNumbers    String?
  chiefComplaint  String?         @db.Text
  diagnosis       String?         @db.Text
  findings        String?         @db.Text
  procedureNotes  String?         @db.Text

  materialsUsed   String?         @db.Text

  status          TreatmentStatus @default(IN_PROGRESS)
  startTime       DateTime?
  endTime         DateTime?

  complications   String?         @db.Text

  followUpRequired Boolean        @default(false)
  followUpDate    DateTime?
  followUpNotes   String?

  cost            Decimal         @db.Decimal(10, 2)

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  hospital        Hospital        @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  patient         Patient         @relation(fields: [patientId], references: [id])
  appointment     Appointment?    @relation(fields: [appointmentId], references: [id])
  procedure       Procedure       @relation(fields: [procedureId], references: [id])
  doctor          Staff           @relation(fields: [doctorId], references: [id])
  invoiceItems    InvoiceItem[]
  documents       Document[]

  @@unique([hospitalId, treatmentNo])
  @@index([hospitalId])
  @@index([patientId])
  @@index([appointmentId])
  @@index([doctorId])
}

enum TreatmentStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Prescription {
  id              String       @id @default(cuid())
  hospitalId      String
  prescriptionNo  String
  patientId       String
  doctorId        String

  diagnosis       String?
  notes           String?      @db.Text

  validUntil      DateTime?

  // Phase 11 — e-prescription workflow: DRAFT → SIGNED → SENT.
  status          PrescriptionStatus @default(DRAFT)
  issuedAt        DateTime?
  pdfUrl          String?           // storage key of the rendered PDF
  sentViaWhatsApp Boolean          @default(false)
  whatsappSentAt  DateTime?
  appointmentId   String?
  treatmentPlanId String?

  appointment     Appointment?     @relation("AppointmentPrescriptions", fields: [appointmentId], references: [id])
  treatmentPlan   TreatmentPlan?   @relation(fields: [treatmentPlanId], references: [id])

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  hospital        Hospital         @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  patient         Patient          @relation(fields: [patientId], references: [id])
  doctor          Staff            @relation(fields: [doctorId], references: [id])
  medications     PrescriptionMedication[]

  @@unique([hospitalId, prescriptionNo])
  @@index([hospitalId])
  @@index([patientId])
  @@index([doctorId])
  @@index([status])
  @@index([appointmentId])
  @@index([treatmentPlanId])
}

enum PrescriptionStatus {
  DRAFT
  SIGNED
  SENT
  CANCELLED
}

// Phase 11 — clinical notes attached to an appointment (doctor documentation).
model ClinicalNote {
  id              String        @id @default(cuid())
  hospitalId      String
  appointmentId   String
  patientId       String
  doctorId        String
  treatmentPlanId String?

  content         String        @db.Text
  noteType        NoteType      @default(GENERAL)
  isPrivate       Boolean       @default(false) // true = DOCTOR/ADMIN only

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  hospital        Hospital      @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  appointment     Appointment   @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  patient         Patient       @relation(fields: [patientId], references: [id])
  doctor          Staff         @relation("DoctorClinicalNotes", fields: [doctorId], references: [id])
  treatmentPlan   TreatmentPlan? @relation(fields: [treatmentPlanId], references: [id])

  @@index([hospitalId])
  @@index([appointmentId])
  @@index([patientId])
}

enum NoteType {
  GENERAL
  EXAMINATION
  TREATMENT
  FOLLOW_UP
  REFERRAL
}

model PrescriptionMedication {
  id              String        @id @default(cuid())
  prescriptionId  String
  medicationId    String?

  medicationName  String
  dosage          String
  frequency       String
  duration        String
  route           String        @default("Oral")
  timing          String?
  quantity        Int?
  instructions    String?

  createdAt       DateTime      @default(now())

  prescription    Prescription  @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medication      Medication?   @relation(fields: [medicationId], references: [id])
}

model Medication {
  id              String       @id @default(cuid())
  hospitalId      String
  name            String
  genericName     String?
  category        String?
  form            String?
  strength        String?
  manufacturer    String?
  defaultDosage   String?
  defaultFrequency String?
  defaultDuration String?
  contraindications String?    @db.Text
  sideEffects     String?      @db.Text
  isActive        Boolean      @default(true)

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  hospital        Hospital     @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  prescriptionMedications PrescriptionMedication[]

  @@index([hospitalId])
  @@index([name])
}

// ==================== BILLING & FINANCIAL ====================

model Invoice {
  id              String        @id @default(cuid())
  hospitalId      String
  invoiceNo       String
  patientId       String

  subtotal        Decimal       @db.Decimal(10, 2)
  discountType    DiscountType?
  discountValue   Decimal?      @db.Decimal(10, 2)
  discountAmount  Decimal       @default(0) @db.Decimal(10, 2)
  taxableAmount   Decimal       @db.Decimal(10, 2)
  cgstRate        Decimal       @default(14) @db.Decimal(5, 2)
  sgstRate        Decimal       @default(0) @db.Decimal(5, 2)
  cgstAmount      Decimal       @db.Decimal(10, 2)
  sgstAmount      Decimal       @db.Decimal(10, 2)
  totalAmount     Decimal       @db.Decimal(10, 2)
  paidAmount      Decimal       @default(0) @db.Decimal(10, 2)
  balanceAmount   Decimal       @db.Decimal(10, 2)

  status          InvoiceStatus @default(DRAFT)
  dueDate         DateTime?

  insuranceClaimId String?
  insuranceAmount Decimal?      @db.Decimal(10, 2)

  // Phase 12 — clinical links, attribution, issue lifecycle, PDF + WhatsApp
  appointmentId   String?
  treatmentPlanId String?
  createdById     String?
  currency        String        @default("EGP")
  issuedAt        DateTime?
  paidAt          DateTime?
  pdfUrl          String?
  sentViaWhatsApp Boolean       @default(false)

  notes           String?       @db.Text
  termsAndConditions String?    @db.Text

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  hospital        Hospital      @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  patient         Patient       @relation(fields: [patientId], references: [id])
  items           InvoiceItem[]
  payments        Payment[]
  paymentLinks    PaymentLink[]
  paymentPlans    PaymentPlan[]
  insuranceClaim  InsuranceClaim? @relation(fields: [insuranceClaimId], references: [id])

  // Phase 12
  appointment     Appointment?    @relation("AppointmentInvoices", fields: [appointmentId], references: [id])
  treatmentPlan   TreatmentPlan?  @relation("TreatmentPlanInvoices", fields: [treatmentPlanId], references: [id])
  createdBy       User?           @relation("UserCreatedInvoices", fields: [createdById], references: [id])

  @@unique([hospitalId, invoiceNo])
  @@index([hospitalId])
  @@index([patientId])
  @@index([status])
  @@index([createdAt])
}

model InvoiceItem {
  id              String     @id @default(cuid())
  invoiceId       String
  treatmentId     String?

  description     String
  quantity        Int        @default(1)
  unitPrice       Decimal    @db.Decimal(10, 2)
  amount          Decimal    @db.Decimal(10, 2)
  taxable         Boolean    @default(true)

  // Phase 12 — optional clinical context
  toothNumber     Int?
  procedureCode   String?

  createdAt       DateTime   @default(now())

  invoice         Invoice    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  treatment       Treatment? @relation(fields: [treatmentId], references: [id])
}

model Payment {
  id              String        @id @default(cuid())
  hospitalId      String
  paymentNo       String
  invoiceId       String

  amount          Decimal       @db.Decimal(10, 2)
  paymentMethod   PaymentMethod
  paymentDate     DateTime      @default(now())

  transactionId   String?
  bankName        String?
  chequeNumber    String?
  chequeDate      DateTime?
  upiId           String?

  notes           String?
  status          PaymentStatus @default(COMPLETED)

  refundAmount    Decimal?      @db.Decimal(10, 2)
  refundDate      DateTime?
  refundReason    String?

  gateway           String?    // fawry / paymob / instapay (legacy rows may hold Indian providers)
  gatewayOrderId    String?    // Provider's order/transaction ID
  gatewayPaymentId  String?    // Provider's payment ID
  gatewayStatus     String?    // Provider-reported status
  gatewayResponse   Json?      // Phase 12 — raw gateway/webhook payload

  // Phase 12 — attribution + patient denormalisation
  patientId         String?
  recordedById      String?

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  hospital        Hospital      @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  invoice         Invoice       @relation(fields: [invoiceId], references: [id])
  patient         Patient?      @relation("PatientInvoicePayments", fields: [patientId], references: [id])
  recordedBy      User?         @relation("UserRecordedPayments", fields: [recordedById], references: [id])

  @@unique([hospitalId, paymentNo])
  @@index([hospitalId])
  @@index([invoiceId])
  @@index([paymentDate])
  @@index([gatewayOrderId])
}

model InsuranceClaim {
  id              String               @id @default(cuid())
  hospitalId      String
  claimNumber     String
  patientId       String
  insuranceProvider String
  policyNumber    String

  claimAmount     Decimal              @db.Decimal(10, 2)
  approvedAmount  Decimal?             @db.Decimal(10, 2)
  settledAmount   Decimal?             @db.Decimal(10, 2)

  status          InsuranceClaimStatus @default(SUBMITTED)
  submittedDate   DateTime             @default(now())
  approvedDate    DateTime?
  settledDate     DateTime?
  rejectionReason String?

  denialCode      String?
  appealDeadline  DateTime?
  appealStatus    String?
  appealDate      DateTime?
  appealNotes     String?              @db.Text

  documents       String?              @db.Text
  notes           String?              @db.Text

  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  hospital        Hospital             @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  patient         Patient              @relation(fields: [patientId], references: [id])
  invoices        Invoice[]

  @@unique([hospitalId, claimNumber])
  @@index([hospitalId])
  @@index([patientId])
  @@index([status])
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum InvoiceStatus {
  DRAFT
  // Phase 12 — explicitly issued (issuedAt + PDF generated)
  ISSUED
  PENDING
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  // Legacy Indian method — retained in the type for historical rows only.
  UPI
  BANK_TRANSFER
  CHEQUE
  INSURANCE
  WALLET
  ONLINE
  // Egyptian methods
  INSTAPAY
  FAWRY
  // Phase 12
  PAYMOB
}

enum PaymentProvider {
  // Legacy Indian providers — retained in the type for historical rows only.
  RAZORPAY
  PHONEPE
  PAYTM
  // Egyptian providers
  FAWRY
  PAYMOB
  INSTAPAY
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
  CANCELLED
}

enum InsuranceClaimStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  PARTIALLY_APPROVED
  REJECTED
  SETTLED
}

// ==================== INSURANCE MANAGEMENT ====================

model InsuranceProviderMaster {
  id              String   @id @default(cuid())
  hospitalId      String
  name            String
  code            String?
  contactPhone    String?
  contactEmail    String?
  website         String?
  claimSubmissionUrl String?
  portalUsername   String?
  portalPassword  String?  @db.Text
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  hospital        Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  policies        PatientInsurance[]

  @@unique([hospitalId, name])
  @@index([hospitalId])
}

model PatientInsurance {
  id                  String    @id @default(cuid())
  hospitalId          String
  patientId           String
  providerId          String
  policyNumber        String
  groupNumber         String?
  memberId            String
  subscriberName      String
  subscriberRelation  String    @default("Self")
  effectiveDate       DateTime
  expiryDate          DateTime?
  coverageType        String?
  annualMaximum       Decimal?  @db.Decimal(10, 2)
  usedAmount          Decimal?  @db.Decimal(10, 2)
  remainingAmount     Decimal?  @db.Decimal(10, 2)
  deductible          Decimal?  @db.Decimal(10, 2)
  deductibleMet       Boolean   @default(false)
  copayPercentage     Decimal?  @db.Decimal(5, 2)
  isActive            Boolean   @default(true)
  lastVerifiedAt      DateTime?
  verificationStatus  String?

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  hospital            Hospital  @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  patient             Patient   @relation(fields: [patientId], references: [id])
  provider            InsuranceProviderMaster @relation(fields: [providerId], references: [id])
  preAuthorizations   PreAuthorization[]

  @@index([hospitalId])
  @@index([patientId])
  @@index([providerId])
}

model PreAuthorization {
  id              String   @id @default(cuid())
  hospitalId      String
  patientId       String
  insurancePolicyId String
  treatmentPlanId String?

  authNumber      String?
  requestDate     DateTime @default(now())
  procedures      Json
  estimatedCost   Decimal  @db.Decimal(10, 2)
  status          PreAuthStatus @default(PENDING)
  approvedAmount  Decimal? @db.Decimal(10, 2)
  approvedDate    DateTime?
  expiryDate      DateTime?
  denialReason    String?
  notes           String?  @db.Text

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  hospital        Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  patient         Patient  @relation(fields: [patientId], references: [id])
  policy          PatientInsurance @relation(fields: [insurancePolicyId], references: [id])

  @@index([hospitalId])
  @@index([patientId])
  @@index([status])
}

enum PreAuthStatus {
  PENDING
  SUBMITTED
  APPROVED
  DENIED
  EXPIRED
}

// ==================== PAYMENT GATEWAY ====================

model PaymentGatewayConfig {
  id              String          @id @default(cuid())
  hospitalId      String          @unique
  provider        PaymentProvider
  isEnabled       Boolean         @default(false)
  isLiveMode      Boolean         @default(false)

  // Legacy Indian provider credentials — columns retained for data
  // compatibility only; no UI or adapter reads them any more.
  razorpayKeyId       String?
  razorpayKeySecret   String?     // Encrypted at rest
  phonepeMerchantId   String?
  phonepeSaltKey      String?     // Encrypted at rest
  phonepeSaltIndex    String?
  paytmMid            String?
  paytmMerchantKey    String?     // Encrypted at rest
  paytmWebsite        String?

  // Fawry
  fawryMerchantCode   String?
  fawrySecretKey      String?     // Encrypted at rest

  // Paymob
  paymobApiKey        String?     // Encrypted at rest
  paymobIntegrationId String?
  paymobIframeId      String?

  // InstaPay
  instapayHandle      String?     // e.g. dentora@instapay

  webhookSecret       String?     // For verifying incoming webhooks
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  hospital            Hospital    @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
}

model PaymentLink {
  id            String    @id @default(cuid())
  hospitalId    String
  invoiceId     String
  token         String    @unique
  amount        Decimal   @db.Decimal(10, 2)
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime  @default(now())

  hospital      Hospital  @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  invoice       Invoice   @relation(fields: [invoiceId], references: [id])

  @@index([hospitalId])
  @@index([token])
  @@index([invoiceId])
}

// ==================== INVENTORY MANAGEMENT ====================

model InventoryCategory {
  id              String    @id @default(cuid())
  hospitalId      String
  name            String
  description     String?
  parentId        String?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  hospital        Hospital  @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  parent          InventoryCategory? @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children        InventoryCategory[] @relation("CategoryHierarchy")
  items           InventoryItem[]

  @@unique([hospitalId, name])
  @@index([hospitalId])
}

model InventoryItem {
  id              String    @id @default(cuid())
  hospitalId      String
  sku             String
  name            String
  categoryId      String?
  description     String?   @db.Text
  itemType        InventoryItemType @default(DENTAL_MATERIAL)
  // Single "preferred supplier" pointer used by the item form and the
  // suppliers list's items-supplied count. Distinct from SupplierItem, which
  // records every supplier that stocks an item along with their SKU/price.
  preferredSupplierId String?

  unit            String
  currentStock    Int       @default(0)
  minimumStock    Int       @default(10)
  reorderLevel    Int       @default(20)
  maximumStock    Int?

  purchasePrice   Decimal   @db.Decimal(10, 2)
  sellingPrice    Decimal?  @db.Decimal(10, 2)
  hsnCode         String?
  taxPercentage   Decimal?  @db.Decimal(5, 2)

  imageUrl        String?
  notes           String?   @db.Text

  manufacturer    String?
  batchTracking   Boolean   @default(false)
  expiryTracking  Boolean   @default(false)

  storageLocation String?
  storageConditions String?

  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  hospital        Hospital  @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  category        InventoryCategory? @relation(fields: [categoryId], references: [id])
  preferredSupplier Supplier? @relation("PreferredSupplierItems", fields: [preferredSupplierId], references: [id])
  stockTransactions StockTransaction[]
  batches         InventoryBatch[]
  supplierItems   SupplierItem[]
  alerts          StockAlert[]

  @@unique([hospitalId, sku])
  @@index([hospitalId])
  @@index([name])
  @@index([currentStock])
  @@index([deletedAt])
  @@index([itemType])
  @@index([preferredSupplierId])
}

enum InventoryItemType {
  DENTAL_MATERIAL
  INSTRUMENT
  CONSUMABLE
  MEDICINE
  OFFICE_SUPPLY
  EQUIPMENT
}

model InventoryBatch {
  id              String    @id @default(cuid())
  hospitalId      String
  itemId          String
  batchNumber     String
  quantity        Int
  remainingQty    Int
  purchasePrice   Decimal   @db.Decimal(10, 2)
  manufacturingDate DateTime?
  expiryDate      DateTime?
  supplierId      String?
  receivedDate    DateTime  @default(now())

  createdAt       DateTime  @default(now())

  hospital        Hospital  @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  item            InventoryItem @relation(fields: [itemId], references: [id])
  supplier        Supplier? @relation(fields: [supplierId], references: [id])
  stockTransactions StockTransaction[]

  @@index([hospitalId])
  @@index([itemId])
  @@index([expiryDate])
}

model StockTransaction {
  id              String               @id @default(cuid())
  hospitalId      String
  itemId          String
  type            StockTransactionType
  quantity        Int
  previousStock   Int
  newStock        Int
  batchNumber     String?

  batchId         String?
  supplierId      String?

  referenceType   String?
  referenceId     String?

  // Where stock moved between, for transfer transactions.
  fromLocation    String?
  toLocation      String?

  unitPrice       Decimal?             @db.Decimal(10, 2)
  totalPrice      Decimal?             @db.Decimal(10, 2)

  notes           String?
  performedBy     String?

  // When the movement happened, which is not always when the row was written
  // (back-dated stock takes, delayed goods-receipt entry).
  transactionDate DateTime             @default(now())
  createdAt       DateTime             @default(now())

  hospital        Hospital             @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  item            InventoryItem        @relation(fields: [itemId], references: [id])
  batch           InventoryBatch?      @relation(fields: [batchId], references: [id])
  supplier        Supplier?            @relation(fields: [supplierId], references: [id])

  @@index([hospitalId])
  @@index([itemId])
  @@index([createdAt])
  @@index([transactionDate])
  @@index([type])
  @@index([batchId])
  @@index([supplierId])
}

enum StockTransactionType {
  PURCHASE
  SALE
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  DAMAGED
  EXPIRED
  RETURNED
  TRANSFERRED
  CONSUMPTION
}

model Supplier {
  id              String    @id @default(cuid())
  hospitalId      String
  code            String
  name            String
  contactPerson   String?
  email           String?
  phone           String
  alternatePhone  String?
  address         String?   @db.Text
  city            String?
  state           String?
  pincode         String?
  gstNumber       String?
  panNumber       String?
  bankAccountNo   String?
  bankIfsc        String?
  paymentTerms    String?
  creditLimit     Decimal?  @db.Decimal(12, 2)
  notes           String?   @db.Text
  rating          Int?      @default(0)
  isActive        Boolean   @default(true)
  // Three-state lifecycle carried over from the legacy `suppliers.status`
  // column. isActive is kept for backwards compatibility and mirrors
  // status != BLOCKED/INACTIVE.
  status          SupplierStatus @default(ACTIVE)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  hospital        Hospital  @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  purchaseOrders  PurchaseOrder[]
  batches         InventoryBatch[]
  supplierItems   SupplierItem[]
  preferredForItems InventoryItem[] @relation("PreferredSupplierItems")
  stockTransactions StockTransaction[]

  @@unique([hospitalId, code])
  @@index([hospitalId])
  @@index([name])
  @@index([status])
  @@index([deletedAt])
}

enum SupplierStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

model SupplierItem {
  id              String    @id @default(cuid())
  supplierId      String
  itemId          String
  supplierSku     String?
  supplierPrice   Decimal   @db.Decimal(10, 2)
  leadTimeDays    Int?
  minimumOrderQty Int?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  supplier        Supplier  @relation(fields: [supplierId], references: [id])
  item            InventoryItem @relation(fields: [itemId], references: [id])

  @@unique([supplierId, itemId])
}

model PurchaseOrder {
  id              String              @id @default(cuid())
  hospitalId      String
  orderNumber     String
  supplierId      String

  orderDate       DateTime            @default(now())
  expectedDate    DateTime?
  receivedDate    DateTime?

  subtotal        Decimal             @db.Decimal(10, 2)
  taxAmount       Decimal             @default(0) @db.Decimal(10, 2)
  totalAmount     Decimal             @db.Decimal(10, 2)

  status          PurchaseOrderStatus @default(DRAFT)
  notes           String?             @db.Text

  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  deletedAt       DateTime?

  hospital        Hospital            @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  supplier        Supplier            @relation(fields: [supplierId], references: [id])
  items           PurchaseOrderItem[]

  @@unique([hospitalId, orderNumber])
  @@index([hospitalId])
  @@index([supplierId])
  @@index([status])
  @@index([orderDate])
  @@index([deletedAt])
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  itemId          String

  quantity        Int
  receivedQty     Int           @default(0)
  unitPrice       Decimal       @db.Decimal(10, 2)
  amount          Decimal       @db.Decimal(10, 2)

  createdAt       DateTime      @default(now())

  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
}

enum PurchaseOrderStatus {
  DRAFT
  SUBMITTED
  APPROVED
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

/// Low-stock / expiry alerts raised against an inventory item.
/// Replaces the legacy `stock_alerts` table that app/api/inventory/alerts
/// queried directly; that table was never part of this schema, so the route
/// only ever worked on machines where the out-of-repo inventory SQL had been
/// applied by hand.
model StockAlert {
  id              String         @id @default(cuid())
  hospitalId      String
  itemId          String

  alertType       StockAlertType
  alertDate       DateTime       @default(now())

  isAcknowledged  Boolean        @default(false)
  acknowledgedBy  String?
  acknowledgedAt  DateTime?

  notes           String?        @db.Text

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  hospital        Hospital       @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  item            InventoryItem  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  acknowledgedByUser User?       @relation(fields: [acknowledgedBy], references: [id])

  @@index([hospitalId])
  @@index([itemId])
  @@index([alertType])
  @@index([isAcknowledged])
  @@index([alertDate])
}

enum StockAlertType {
  OUT_OF_STOCK
  LOW_STOCK
  EXPIRING_SOON
  EXPIRED
}

// ==================== LAB WORK MANAGEMENT ====================

model LabVendor {
  id              String    @id @default(cuid())
  hospitalId      String
  code            String?
  name            String
  contactPerson   String?
  phone           String
  alternatePhone  String?
  email           String?
  address         String?   @db.Text
  city            String?
  state           String?
  pincode         String?
  gstNumber       String?
  panNumber       String?
  specializations String?   @db.Text
  avgTurnaround   Int?
  rating          Int?      @default(0)
  paymentTerms    String?
  creditLimit     Decimal?  @db.Decimal(12, 2)
  notes           String?   @db.Text
  isActive        Boolean   @default(true)
  status          LabVendorStatus @default(ACTIVE)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  hospital        Hospital  @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  labOrders       LabOrder[]

  @@index([hospitalId])
  @@index([status])
  @@index([deletedAt])
}

enum LabVendorStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

model LabOrder {
  id              String         @id @default(cuid())
  hospitalId      String
  orderNumber     String
  patientId       String
  labVendorId     String

  workType        LabWorkType
  description     String?        @db.Text
  toothNumbers    String?
  shadeGuide      String?

  orderDate       DateTime       @default(now())
  expectedDate    DateTime?
  sentDate        DateTime?
  receivedDate    DateTime?
  deliveredDate   DateTime?

  estimatedCost   Decimal        @db.Decimal(10, 2)
  actualCost      Decimal?       @db.Decimal(10, 2)

  status          LabOrderStatus @default(CREATED)
  priority        LabOrderPriority @default(NORMAL)
  qualityCheck    QualityCheckStatus?
  qualityNotes    String?

  notes           String?        @db.Text
  specialInstructions String?    @db.Text
  createdBy       String?

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?

  hospital        Hospital       @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  patient         Patient        @relation(fields: [patientId], references: [id])
  labVendor       LabVendor      @relation(fields: [labVendorId], references: [id])
  history         LabOrderHistory[]
  documents       LabOrderDocument[]

  @@unique([hospitalId, orderNumber])
  @@index([hospitalId])
  @@index([patientId])
  @@index([status])
  @@index([orderDate])
  @@index([deletedAt])
}

/// Status-transition audit trail for a lab order. Replaces the legacy
/// `lab_order_history` table written by app/api/lab-orders/[id]/status.
model LabOrderHistory {
  id              String          @id @default(cuid())
  labOrderId      String

  statusFrom      LabOrderStatus?
  statusTo        LabOrderStatus
  changedBy       String?
  notes           String?         @db.Text

  createdAt       DateTime        @default(now())

  labOrder        LabOrder        @relation(fields: [labOrderId], references: [id], onDelete: Cascade)
  changedByUser   User?           @relation(fields: [changedBy], references: [id])

  @@index([labOrderId])
  @@index([createdAt])
}

/// Files attached to a lab order (scans, prescriptions, shade photos).
/// Replaces the legacy `lab_order_documents` table.
model LabOrderDocument {
  id              String    @id @default(cuid())
  labOrderId      String

  fileName        String
  fileUrl         String
  fileType        String?
  fileSize        Int?
  documentType    String?
  uploadedBy      String?

  createdAt       DateTime  @default(now())

  labOrder        LabOrder  @relation(fields: [labOrderId], references: [id], onDelete: Cascade)
  uploadedByUser  User?     @relation(fields: [uploadedBy], references: [id])

  @@index([labOrderId])
  @@index([createdAt])
}

enum LabWorkType {
  CROWN
  BRIDGE
  DENTURE
  PARTIAL_DENTURE
  IMPLANT_CROWN
  VENEER
  INLAY_ONLAY
  NIGHT_GUARD
  RETAINER
  ALIGNER
  MODEL
  OTHER
}

enum LabOrderPriority {
  NORMAL
  URGENT
}

enum LabOrderStatus {
  CREATED
  SENT_TO_LAB
  IN_PROGRESS
  QUALITY_CHECK
  READY
  DELIVERED
  FITTED
  REMAKE_REQUIRED
  CANCELLED
}

enum QualityCheckStatus {
  PENDING
  PASSED
  FAILED
  CONDITIONALLY_PASSED
}

// ==================== DOCUMENTS ====================

model Document {
  id              String       @id @default(cuid())
  hospitalId      String
  patientId       String
  treatmentId     String?

  fileName        String
  originalName    String
  fileType        String
  fileSize        Int
  filePath        String

  documentType    DocumentType
  description     String?

  isArchived      Boolean      @default(false)
  uploadedBy      String?

  // Annotation data (Phase 6)
  annotations     Json?        // Array of annotation objects [{type, points, color, text, ...}]
  annotatedBy     String?      // userId who annotated
  annotatedAt     DateTime?

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  hospital        Hospital     @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  patient         Patient      @relation(fields: [patientId], references: [id])
  treatment       Treatment?   @relation(fields: [treatmentId], references: [id])

  @@index([hospitalId])
  @@index([patientId])
  @@index([documentType])
}

enum DocumentType {
  XRAY
  CT_SCAN
  PHOTO
  CONSENT_FORM
  PRESCRIPTION
  LAB_REPORT
  INSURANCE
  ID_PROOF
  OTHER
}

// ==================== NOTIFICATIONS ====================

model Notification {
  id              String           @id @default(cuid())
  hospitalId      String
  userId          String

  title           String
  message         String           @db.Text
  type            NotificationType

  isRead          Boolean          @default(false)
  readAt          DateTime?

  entityType      String?
  entityId        String?

  createdAt       DateTime         @default(now())

  hospital        Hospital         @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([hospitalId])
  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
  APPOINTMENT
  PAYMENT
  INVENTORY
  SYSTEM
}

// ==================== AUDIT LOGS ====================

model AuditLog {
  id              String    @id @default(cuid())
  hospitalId      String
  userId          String?

  action          String
  entityType      String
  entityId        String

  oldValues       String?   @db.Text
  newValues       String?   @db.Text

  ipAddress       String?
  userAgent       String?

  createdAt       DateTime  @default(now())

  hospital        Hospital  @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  user            User?     @relation(fields: [userId], references: [id])

  @@index([hospitalId])
  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
}

// ==================== SETTINGS ====================

model Setting {
  id              String    @id @default(cuid())
  hospitalId      String
  key             String
  value           String    @db.Text
  type            String    @default("string")
  category        String    @default("general")
  description     String?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  hospital        Hospital  @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@unique([hospitalId, key])
  @@index([hospitalId])
  @@index([category])
}

model Holiday {
  id              String    @id @default(cuid())
  hospitalId      String
  name            String
  date            DateTime  @db.Date
  isRecurring     Boolean   @default(false)

  createdAt       DateTime  @default(now())

  hospital        Hospital  @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@index([hospitalId])
  @@index([date])
}

// ==================== COMMUNICATION SYSTEM ====================

model CommunicationTemplate {
  id              String              @id @default(cuid())
  hospitalId      String
  name            String
  category        TemplateCategory
  channel         CommunicationChannel

  subject         String?
  content         String              @db.Text
  variables       String?             @db.Text

  language        String              @default("en")
  isActive        Boolean             @default(true)
  isDefault       Boolean             @default(false)

  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  hospital        Hospital            @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  smsLogs         SMSLog[]
  emailLogs       EmailLog[]

  @@index([hospitalId])
  @@index([category])
  @@index([channel])
}

// Lifecycle of outbound SMS / email log entries (6-state — matches the
// SMSLog.status and EmailLog.status DB columns).
enum MessageStatus {
  PENDING
  QUEUED
  SENT
  DELIVERED
  FAILED
  CANCELLED
}

model SMSLog {
  id              String        @id @default(cuid())
  hospitalId      String
  patientId       String?
  phone           String

  templateId      String?
  message         String        @db.Text

  gateway         String?
  status          MessageStatus @default(PENDING)
  deliveryStatus  String?

  scheduledFor    DateTime?
  sentAt          DateTime?
  deliveredAt     DateTime?
  failedAt        DateTime?

  errorMessage    String?
  cost            Decimal?      @db.Decimal(10, 4)
  messageId       String?

  metadata        String?       @db.Text

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  hospital        Hospital      @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  template        CommunicationTemplate? @relation(fields: [templateId], references: [id])

  @@index([hospitalId])
  @@index([patientId])
  @@index([phone])
  @@index([status])
  @@index([sentAt])
}

model EmailLog {
  id              String        @id @default(cuid())
  hospitalId      String
  patientId       String?
  email           String

  templateId      String?
  subject         String
  body            String        @db.Text

  attachments     String?       @db.Text

  status          MessageStatus @default(PENDING)

  scheduledFor    DateTime?
  sentAt          DateTime?
  openedAt        DateTime?
  clickedAt       DateTime?
  failedAt        DateTime?

  trackingId      String?       @unique  // UUID for open tracking pixel

  errorMessage    String?
  messageId       String?

  metadata        String?       @db.Text

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  hospital        Hospital      @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  template        CommunicationTemplate? @relation(fields: [templateId], references: [id])

  @@index([hospitalId])
  @@index([patientId])
  @@index([email])
  @@index([status])
  @@index([sentAt])
}

model PatientCommunicationPreference {
  id              String    @id @default(cuid())
  patientId       String    @unique

  smsEnabled      Boolean   @default(true)
  emailEnabled    Boolean   @default(true)
  whatsappEnabled Boolean   @default(false)

  appointmentReminders Boolean @default(true)
  paymentReminders    Boolean  @default(true)
  promotionalMessages Boolean  @default(true)
  birthdayWishes      Boolean  @default(true)

  preferredLanguage   String   @default("en")
  preferredChannel    CommunicationChannel @default(SMS)

  dndRegistered       Boolean  @default(false)
  unsubscribedAt      DateTime?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([patientId])
}

model Survey {
  id              String        @id @default(cuid())
  hospitalId      String
  title           String
  description     String?       @db.Text

  surveyType      SurveyType    @default(SATISFACTION)
  isAnonymous     Boolean       @default(false)

  questions       String        @db.Text

  isActive        Boolean       @default(true)
  validFrom       DateTime      @default(now())
  validUntil      DateTime?

  triggerType     SurveyTrigger?

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  hospital        Hospital      @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  responses       SurveyResponse[]

  @@index([hospitalId])
  @@index([isActive])
  @@index([surveyType])
}

model SurveyResponse {
  id              String        @id @default(cuid())
  surveyId        String
  patientId       String?

  answers         String        @db.Text
  rating          Int?
  sentiment       String?

  isComplete      Boolean       @default(false)

  ipAddress       String?
  userAgent       String?

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  survey          Survey        @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  @@index([surveyId])
  @@index([patientId])
  @@index([createdAt])
}

model BulkCommunication {
  id              String              @id @default(cuid())
  hospitalId      String
  name            String
  description     String?

  channel         CommunicationChannel
  templateId      String?

  filterCriteria  String?             @db.Text
  recipientCount  Int                 @default(0)

  status          BulkCommStatus      @default(DRAFT)

  scheduledFor    DateTime?
  startedAt       DateTime?
  completedAt     DateTime?

  sentCount       Int                 @default(0)
  failedCount     Int                 @default(0)

  estimatedCost   Decimal?            @db.Decimal(10, 2)
  actualCost      Decimal?            @db.Decimal(10, 2)

  createdBy       String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  hospital        Hospital            @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@index([hospitalId])
  @@index([status])
  @@index([scheduledFor])
}

enum TemplateCategory {
  APPOINTMENT
  PAYMENT
  BIRTHDAY
  PROMOTIONAL
  FOLLOW_UP
  LAB_WORK
  PRESCRIPTION
  GENERAL
}

enum CommunicationChannel {
  SMS
  EMAIL
  WHATSAPP
  IN_APP
}

enum SurveyType {
  SATISFACTION
  NPS
  FEEDBACK
  TESTIMONIAL
  SERVICE_QUALITY
}

enum SurveyTrigger {
  POST_APPOINTMENT
  POST_TREATMENT
  MONTHLY
  MANUAL
}

enum BulkCommStatus {
  DRAFT
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  FAILED
  CANCELLED
}

// ==================== AI FEATURES ====================

enum AISessionType {
  CHAT
  COMMAND
  ANALYSIS
  QUERY
}

enum AIExecutionStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum AIInsightCategory {
  REVENUE
  CLINICAL
  OPERATIONAL
  PATIENT
  STAFFING
  INVENTORY
}

enum InsightSeverity {
  INFO
  WARNING
  CRITICAL
}

model AIConversation {
  id          String        @id @default(cuid())
  hospitalId  String
  userId     String
  sessionType AISessionType
  messages    Json
  context     Json
  resolved    Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  hospital    Hospital      @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([hospitalId])
  @@index([userId])
  @@index([createdAt])
}

model AISkillExecution {
  id         String            @id @default(cuid())
  hospitalId String
  userId    String?
  skill      String
  input      Json
  output     Json?
  status     AIExecutionStatus @default(PENDING)
  duration   Int?
  tokensUsed Int?
  cost       Decimal?          @db.Decimal(10, 6)
  error      String?
  createdAt  DateTime          @default(now())

  hospital   Hospital          @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@index([hospitalId])
  @@index([skill])
  @@index([status])
  @@index([createdAt])
}

model AIInsight {
  id          String            @id @default(cuid())
  hospitalId  String
  category    AIInsightCategory
  severity    InsightSeverity
  title       String
  description String            @db.Text
  data        Json?
  dismissed   Boolean           @default(false)
  actionTaken Boolean           @default(false)
  createdAt   DateTime          @default(now())
  expiresAt   DateTime?

  hospital    Hospital          @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@index([hospitalId])
  @@index([category])
  @@index([severity])
  @@index([dismissed])
  @@index([createdAt])
}

model PatientRiskScore {
  id                String   @id @default(cuid())
  patientId         String
  hospitalId        String
  overallScore      Int
  factors           Json
  contraindications Json?
  calculatedAt      DateTime @default(now())

  patient           Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  hospital          Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([hospitalId])
  @@index([calculatedAt])
}

// ==================== INTAKE FORMS & CONSENT ====================

model FormTemplate {
  id          String         @id @default(cuid())
  hospitalId  String
  name        String
  description String?        @db.Text
  type        FormType
  fields      Json           // Array of field definitions
  isActive    Boolean        @default(true)
  isDefault   Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  hospital    Hospital       @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  submissions FormSubmission[]

  @@index([hospitalId])
  @@index([type])
}

model FormSubmission {
  id            String               @id @default(cuid())
  hospitalId    String
  templateId    String
  patientId     String?
  appointmentId String?

  data          Json                 // Submitted form data
  signature     String?              @db.LongText
  signedAt      DateTime?
  ipAddress     String?

  status        FormSubmissionStatus @default(SUBMITTED)
  reviewedBy    String?
  reviewedAt    DateTime?
  reviewNotes   String?              @db.Text

  createdAt     DateTime             @default(now())

  hospital      Hospital             @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  template      FormTemplate         @relation(fields: [templateId], references: [id])

  @@index([hospitalId])
  @@index([patientId])
  @@index([appointmentId])
  @@index([status])
}

enum FormType {
  MEDICAL_HISTORY
  CONSENT
  INTAKE
  FEEDBACK
  CUSTOM
}

enum FormSubmissionStatus {
  SUBMITTED
  REVIEWED
  APPROVED
  REJECTED
}

// ==================== PATIENT PORTAL ====================

model PatientOTP {
  id          String   @id @default(cuid())
  hospitalId  String
  phone       String
  otp         String
  expiresAt   DateTime
  verified    Boolean  @default(false)
  attempts    Int      @default(0)
  createdAt   DateTime @default(now())

  hospital    Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@index([phone, hospitalId])
  @@index([expiresAt])
}

// ==================== CRM, LOYALTY & REFERRALS ====================

model MembershipPlan {
  id            String   @id @default(cuid())
  hospitalId    String
  name          String
  description   String?  @db.Text
  price         Decimal  @db.Decimal(10, 2)
  duration      Int      // months
  benefits      Json     // Array of { procedureId?, category?, discountPercent, description }
  maxMembers    Int?     // family plan limit
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  hospital      Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  memberships   PatientMembership[]

  @@index([hospitalId])
}

model PatientMembership {
  id            String   @id @default(cuid())
  hospitalId    String
  patientId     String
  planId        String
  startDate     DateTime
  endDate       DateTime
  status        MembershipStatus @default(ACTIVE)
  paymentId     String?
  autoRenew     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  hospital      Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  patient       Patient  @relation(fields: [patientId], references: [id])
  plan          MembershipPlan @relation(fields: [planId], references: [id])

  @@index([hospitalId])
  @@index([patientId])
  @@index([status])
}

model Referral {
  id                String   @id @default(cuid())
  hospitalId        String
  referrerPatientId String
  referredPatientId String?
  referredName      String
  referredPhone     String
  referralCode      String   @unique
  status            ReferralStatus @default(PENDING)
  rewardType        String?  // DISCOUNT / CREDIT / POINTS
  rewardValue       Decimal? @db.Decimal(10, 2)
  rewardGiven       Boolean  @default(false)
  rewardGivenAt     DateTime?
  convertedAt       DateTime?
  createdAt         DateTime @default(now())

  hospital          Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@index([hospitalId])
  @@index([referrerPatientId])
  @@index([referralCode])
}

model LoyaltyTransaction {
  id            String   @id @default(cuid())
  hospitalId    String
  patientId     String
  points        Int      // positive = earned, negative = redeemed
  type          String   // VISIT, REFERRAL, TREATMENT, REDEMPTION, BIRTHDAY, SIGNUP
  description   String
  referenceId   String?  // appointmentId, referralId, etc.
  createdAt     DateTime @default(now())

  hospital      Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@index([hospitalId])
  @@index([patientId])
}

enum MembershipStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  SUSPENDED
}

enum ReferralStatus {
  PENDING
  CONVERTED
  EXPIRED
  REWARDED
}

// ==================== CALENDAR SYNC & SMART SCHEDULING (Phase 7) ====================

model CalendarIntegration {
  id             String   @id @default(cuid())
  hospitalId     String
  userId         String
  provider       String   // GOOGLE / OUTLOOK
  accessToken    String   @db.Text
  refreshToken   String   @db.Text
  calendarId     String?
  syncEnabled    Boolean  @default(true)
  lastSyncAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  hospital       Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id])

  @@unique([userId, provider])
  @@index([hospitalId])
}

model Room {
  id          String   @id @default(cuid())
  hospitalId  String
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  hospital     Hospital     @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  blockedSlots BlockedSlot[]

  @@unique([hospitalId, name])
  @@index([hospitalId])
}

model Waitlist {
  id             String         @id @default(cuid())
  hospitalId     String
  patientId      String
  doctorId       String?
  preferredDays  Json?          // ["MONDAY", "WEDNESDAY"]
  preferredTime  String?        // "MORNING" | "AFTERNOON" | "EVENING"
  procedureId    String?
  notes          String?
  status         WaitlistStatus @default(ACTIVE)
  notifiedAt     DateTime?
  bookedAt       DateTime?
  createdAt      DateTime       @default(now())

  hospital       Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@index([hospitalId])
  @@index([status])
}

// ── Agenda Phase 2b: per-doctor recurring breaks & arbitrary blocked time ──
model DoctorBreak {
  id          String   @id @default(cuid())
  hospitalId  String
  staffId     String
  dayOfWeek   Int      // 0 (Sunday) – 6 (Saturday), matches StaffShift
  startTime   String   // HH:MM 24h
  endTime     String   // HH:MM 24h
  label       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  staff    Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([hospitalId])
  @@index([staffId, dayOfWeek])
}

model BlockedSlot {
  id         String   @id @default(cuid())
  hospitalId String
  staffId    String?  // optional: clinic-wide block when null
  roomId     String?
  startAt    DateTime
  endAt      DateTime
  reason     String?
  isActive   Boolean  @default(true)
  createdBy  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  hospital Hospital  @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  staff    Staff?    @relation(fields: [staffId], references: [id], onDelete: SetNull)
  room     Room?     @relation(fields: [roomId], references: [id], onDelete: SetNull)

  @@index([hospitalId, startAt])
  @@index([staffId])
  @@index([roomId])
}

// ── Messaging platform: provider-agnostic outbound message queue ──────────
model MessageQueue {
  id            String         @id @default(cuid())
  hospitalId    String
  appointmentId String?
  patientId     String?
  recipient     String         // E.164 phone number
  channel       MessageChannel
  provider      String?        // provider that handled the last attempt
  messageType   MessageType
  payload       Json           // { text, attachment?: { filename, mimeType, dataBase64 } }
  scheduledAt   DateTime
  sentAt        DateTime?
  status        MessageQueueStatus @default(PENDING)
  attempts      Int            @default(0)
  lastError     String?
  // Phase 10 — provider correlation + delivery tracking (webhook-driven).
  providerMessageId String?    // Meta wamid / Baileys message key id
  deliveryStatus    String?    // SENT | DELIVERED | READ | FAILED (provider-reported)
  deliveredAt       DateTime?
  readAt            DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  hospital    Hospital     @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  patient     Patient?     @relation(fields: [patientId], references: [id], onDelete: SetNull)

  @@index([hospitalId])
  @@index([status, scheduledAt])
  @@index([appointmentId])
  @@index([patientId])
  @@index([providerMessageId])
}

enum MessageChannel {
  WHATSAPP
  SMS
}

enum MessageQueueStatus {
  PENDING
  SENT
  FAILED
  CANCELLED
}

enum MessageType {
  APPOINTMENT_CONFIRMATION
  APPOINTMENT_REMINDER_24H
  APPOINTMENT_REMINDER_1H
  DOCTOR_NEW_APPOINTMENT
  DOCTOR_CANCELLATION
  DOCTOR_RESCHEDULE
  PRESCRIPTION
  INVOICE
  RADIOLOGY
  REVIEW_REQUEST
  TEST
}

enum WaitlistStatus {
  ACTIVE
  NOTIFIED
  BOOKED
  CANCELLED
  EXPIRED
}

// ==================== PAYMENT PLANS & REVENUE CYCLE (Phase 8) ====================

model PaymentPlan {
  id              String            @id @default(cuid())
  hospitalId      String
  invoiceId       String
  patientId       String
  totalAmount     Decimal           @db.Decimal(10, 2)
  downPayment     Decimal           @default(0) @db.Decimal(10, 2)
  installments    Int
  frequency       PlanFrequency     @default(MONTHLY)
  interestRate    Decimal           @default(0) @db.Decimal(5, 2)
  status          PaymentPlanStatus @default(ACTIVE)
  startDate       DateTime
  nextDueDate     DateTime?
  notes           String?           @db.Text
  createdBy       String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  hospital        Hospital          @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  invoice         Invoice           @relation(fields: [invoiceId], references: [id])
  patient         Patient           @relation(fields: [patientId], references: [id])
  schedules       PaymentPlanSchedule[]

  @@index([hospitalId])
  @@index([patientId])
  @@index([invoiceId])
  @@index([status])
  @@index([nextDueDate])
}

model PaymentPlanSchedule {
  id              String            @id @default(cuid())
  planId          String
  installmentNo   Int
  amount          Decimal           @db.Decimal(10, 2)
  dueDate         DateTime
  paidDate        DateTime?
  paidAmount      Decimal?          @db.Decimal(10, 2)
  paymentId       String?
  status          InstallmentStatus @default(PENDING)

  plan            PaymentPlan       @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
  @@index([dueDate])
  @@index([status])
}

enum PlanFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum PaymentPlanStatus {
  ACTIVE
  COMPLETED
  DEFAULTED
  CANCELLED
}

enum InstallmentStatus {
  PENDING
  PAID
  OVERDUE
  WAIVED
}

// ==================== VIDEO CONSULTATION ====================

model VideoConsultation {
  id              String             @id @default(cuid())
  hospitalId      String
  appointmentId   String?            @unique
  patientId       String
  doctorId        String
  roomUrl         String
  roomName        String
  status          ConsultationStatus @default(SCHEDULED)
  scheduledAt     DateTime
  startedAt       DateTime?
  endedAt         DateTime?
  duration        Int?
  notes           String?            @db.Text
  recordingUrl    String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  hospital        Hospital           @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  appointment     Appointment?       @relation(fields: [appointmentId], references: [id])
  patient         Patient            @relation(fields: [patientId], references: [id])
  doctor          Staff              @relation("DoctorVideoConsultations", fields: [doctorId], references: [id])

  @@index([hospitalId])
  @@index([doctorId])
  @@index([patientId])
  @@index([status])
  @@index([scheduledAt])
}

enum ConsultationStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

// ─── Phase 11: Marketing Automation ───────────────────────────────

model MarketingAutomation {
  id          String   @id @default(cuid())
  hospitalId  String
  name        String
  trigger     Json     // { type, params } — e.g. { type: "NO_VISIT", params: { days: 180 } }
  action      Json     // { type, params } — e.g. { type: "SEND_SMS", params: { templateId: "..." } }
  isActive    Boolean  @default(true)
  lastRunAt   DateTime?
  runCount    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  hospital    Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@index([hospitalId])
  @@index([isActive])
}

// ─── Phase 13: Sterilization & Instrument Tracking ────────────────

model Instrument {
  id                    String           @id @default(cuid())
  hospitalId            String
  name                  String
  category              String
  serialNumber          String?
  rfidTag               String?
  status                InstrumentStatus @default(AVAILABLE)
  location              String?
  lastSterilizedAt      DateTime?
  sterilizationCycleCount Int            @default(0)
  maxCycles             Int?
  purchaseDate          DateTime?
  warrantyDate          DateTime?
  notes                 String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  hospital              Hospital         @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  sterilizationLogs     SterilizationLog[]

  @@index([hospitalId])
  @@index([status])
  @@index([rfidTag])
}

model SterilizationLog {
  id                  String              @id @default(cuid())
  hospitalId          String
  instrumentId        String
  cycleNumber         Int
  method              String              // AUTOCLAVE, CHEMICAL, DRY_HEAT, UV
  machineId           String?
  temperature         Decimal?            @db.Decimal(5, 1)
  pressure            Decimal?            @db.Decimal(5, 2)
  duration            Int?                // minutes
  operatorId          String
  result              SterilizationResult @default(PASS)
  biologicalIndicator Boolean             @default(false)
  chemicalIndicator   Boolean             @default(false)
  notes               String?
  startedAt           DateTime
  completedAt         DateTime?
  createdAt           DateTime            @default(now())

  hospital            Hospital            @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  instrument          Instrument          @relation(fields: [instrumentId], references: [id])

  @@index([hospitalId])
  @@index([instrumentId])
  @@index([startedAt])
}

enum InstrumentStatus {
  AVAILABLE
  IN_USE
  STERILIZING
  CONTAMINATED
  MAINTENANCE
  RETIRED
}

enum SterilizationResult {
  PASS
  FAIL
  PENDING
}

// ==================== IoT / SMART DEVICES ====================

model Device {
  id            String   @id @default(cuid())
  hospitalId    String
  name          String
  type          String   // DENTAL_CHAIR, PULSE_OXIMETER, BP_MONITOR, AUTOCLAVE, XRAY, COMPRESSOR
  serialNumber  String?
  location      String?  // e.g. "Operatory 1", "Sterilization Room"
  status        DeviceStatus @default(OFFLINE)
  lastPingAt    DateTime?
  ipAddress     String?
  firmwareVersion String?
  metadata      Json?    // Arbitrary device-specific config
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  hospital      Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  dataLogs      DeviceDataLog[]

  @@index([hospitalId])
  @@index([status])
  @@index([type])
}

model DeviceDataLog {
  id        String   @id @default(cuid())
  deviceId  String
  data      Json     // { heartRate: 72, bp: "120/80", spo2: 98, temperature: 36.5, ... }
  eventType String?  // READING, ALERT, STATUS_CHANGE, ERROR
  timestamp DateTime @default(now())

  device    Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId])
  @@index([timestamp])
  @@index([eventType])
}

enum DeviceStatus {
  ONLINE
  OFFLINE
  ERROR
  MAINTENANCE
}

// ==================== PUSH NOTIFICATIONS (Mobile App) ====================

model PushDevice {
  id         String   @id @default(cuid())
  token      String   @unique
  platform   String   // "ios", "android", "web"
  deviceName String?
  isActive   Boolean  @default(true)

  userId     String
  hospitalId String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@index([hospitalId])
  @@index([isActive])
}

// ==================== DATA IMPORT / ERP MIGRATION ====================

model DataImportJob {
  id              String           @id @default(cuid())
  hospitalId      String
  userId          String

  fileName        String
  fileType        String           // "csv" | "xlsx" | "xls" | "pdf"
  filePath        String
  entityType      String           // "patients" | "appointments" | "treatments" | "invoices" | "payments" | "inventory" | "staff"

  status          DataImportStatus @default(UPLOADED)

  sourceColumns   Json?            // string[]
  columnMapping   Json?            // Record<string, string | null>
  previewData     Json?            // first N rows of parsed data
  validationErrors Json?           // array of { row, field, message }

  totalRows       Int              @default(0)
  successCount    Int              @default(0)
  errorCount      Int              @default(0)

  signedOffAt     DateTime?
  completedAt     DateTime?
  errorLog        String?          @db.LongText

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  hospital        Hospital         @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  user            User             @relation(fields: [userId], references: [id])

  @@index([hospitalId])
  @@index([status])
}

enum DataImportStatus {
  UPLOADED
  MAPPED
  VALIDATED
  IMPORTING
  COMPLETED
  FAILED
  CANCELLED
}

// ==================== AI IMAGING — PHASE 19A ====================
// Imaging studies (uploaded X-rays/photos) and the AI analysis jobs run
// against them by the AI platform (ai-compose.yml). Ownership:
//   - Next.js creates the study (UPLOADED) and the job (PENDING), and owns
//     doctor review (reviewDecision / acceptedFindings / study -> REVIEWED)
//   - the AI orchestrator owns processing transitions
//     (PENDING -> PROCESSING -> COMPLETED/FAILED) + provenance
// Originals are IMMUTABLE: AI outputs are stored as separate objects under
// {hospitalId}/imaging/.../ai/... (see lib/storage/keys.ts tenant guard).

enum StudyModality {
  PANORAMIC
  PERIAPICAL
  BITEWING
  CBCT
  THREE_D_SCAN
  PHOTO
}

enum ImagingStudyStatus {
  UPLOADED
  ANALYZED
  REVIEWED
}

enum AIJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum AIReviewDecision {
  ACCEPTED
  MODIFIED
  REJECTED
}

model ImagingStudy {
  id            String    @id @default(cuid())
  hospitalId    String
  patientId     String
  appointmentId String?

  studyType     String
  modality      StudyModality

  // The original image object. Immutable after upload (the AI stack is
  // read-only with respect to this key).
  originalKey   String    @unique
  originalSize  Int
  originalHash  String
  mimeType      String

  studyDate     DateTime?
  description   String?   @db.Text
  uploadedById  String?

  status        ImagingStudyStatus @default(UPLOADED)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  hospital      Hospital     @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  patient       Patient      @relation(fields: [patientId], references: [id])
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  uploadedBy    User?        @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  aiJobs        AIAnalysisJob[]

  @@index([hospitalId])
  @@index([hospitalId, patientId])
  @@index([status])
}

model AIAnalysisJob {
  id            String    @id @default(cuid())
  hospitalId    String
  studyId       String
  engine        String
  status        AIJobStatus @default(PENDING)

  requestedById String?

  // Provenance — the exact artifact that ran (D9 / spec section 13).
  modelVersion        String?
  modelChecksum       String?
  modelSource         String?
  modelLicense        String?
  orchestratorVersion String?

  startedAt        DateTime?
  completedAt      DateTime?
  processingTimeMs Int?

  rawOutputKey   String?
  findings       Json?
  confidence     Float?
  errorMessage   String? @db.Text
  provenance     Json?

  reviewedById   String?
  reviewedAt     DateTime?
  reviewDecision AIReviewDecision?
  reviewNotes    String? @db.Text
  acceptedFindings Json?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  hospital    Hospital      @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  study       ImagingStudy  @relation(fields: [studyId], references: [id], onDelete: Cascade)
  requestedBy User?         @relation(fields: [requestedById], references: [id], onDelete: SetNull)
  reviewedBy  User?         @relation("AIJobReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([hospitalId])
  @@index([studyId])
  @@index([status])
  @@index([hospitalId, status])
}
