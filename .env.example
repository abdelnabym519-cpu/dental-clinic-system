# =============================================================
# DentalERP Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================

# ── Database (MySQL) ──────────────────────────────────────────
# Replace 'root' and 'password' with your MySQL credentials.
# Using docker-compose.dev.yml? The matching value is:
#   DATABASE_URL="mysql://root:dental@localhost:3306/dental_erp"
DATABASE_URL="mysql://root:password@localhost:3306/dental_erp"

# ── NextAuth ──────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=""

# ── File Storage ──────────────────────────────────────────────
# "local" (default) or "s3". Local disk is correct for a single instance and
# needs nothing else running. See docs/STORAGE.md for how to choose, and for
# the one-command migration between them.
STORAGE_DRIVER="local"
# Where the local driver keeps files. Relative paths resolve against the
# application directory.
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE="10485760"

# ── Object Storage (S3-compatible) — Optional ───────────────────
# Only read when STORAGE_DRIVER="s3". Works against MinIO, AWS S3, Cloudflare
# R2, DigitalOcean Spaces and anything else speaking the same API.
#
# Setting these alone changes nothing: the driver switch is STORAGE_DRIVER, and
# it is separate on purpose, because your existing files do not move on their
# own. Copy them across first — `npm run storage:migrate -- --dry-run`.
#
# The values below match docker-compose.dev.yml.
# S3_ENDPOINT="http://localhost:9000"
# S3_ACCESS_KEY="dentalerp"
# S3_SECRET_KEY="dentalerp123"
# S3_BUCKET="dental-erp-uploads"
# S3_REGION="us-east-1"
# MinIO and most non-AWS S3 implementations need path-style addressing
# S3_FORCE_PATH_STYLE="true"

# ── Cache / Queue (Redis) ──────────────────────────────────────
# Required for the Baileys WhatsApp provider (session + QR persistence —
# Phase 10, OPTION B below). Otherwise optional: leave unset and caching
# and rate limiting stay in-process, which is correct for a single instance.
# REDIS_URL="redis://localhost:6379"

# ── Application ───────────────────────────────────────────────
NODE_ENV="development"

# ── Payment Gateway Encryption (REQUIRED) ─────────────────────
# AES-256-GCM needs a 64-character hex string (32 bytes)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=""

# ── Cron Jobs Security (REQUIRED) ────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
CRON_SECRET=""

# ── AI (OpenRouter) — Optional ────────────────────────────────
# Sign up at https://openrouter.ai to get an API key
# Required only for AI features (treatment advisor, smart scheduler, etc.)
OPENROUTER_API_KEY=""

# ── Email (SMTP) — Optional ──────────────────────────────────
# Required for email notifications, password reset, etc.
#
# For local development use Mailpit from docker-compose.dev.yml. It accepts
# every message, delivers none of them, and shows you the result at
# http://localhost:8025 — so you can exercise the email paths with no
# credentials and no chance of mailing a real patient:
#   SMTP_HOST="localhost"
#   SMTP_PORT="1025"
#   SMTP_SECURE="false"
#   SMTP_USER=""
#   SMTP_PASSWORD=""
SMTP_HOST="smtp.example.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASSWORD=""

# ── SMS Gateway — Optional ───────────────────────────────────
# Required for SMS appointment reminders
SMS_API_KEY=""
SMS_SENDER_ID="DENTAL"

# ── Video Consultation — Optional ─────────────────────────────
# Jitsi Meet (free, no API key needed)
JITSI_DOMAIN="meet.jit.si"
# Or use Daily.co (requires API key):
# DAILY_API_KEY=""
# DAILY_DOMAIN="your-domain.daily.co"

# ── WhatsApp / SMS Messaging Platform ─────────────────────────
# Master switch: when not "true", the built-in mock provider handles all
# sends locally (no external calls) so the pipeline stays verifiable.
MESSAGING_ENABLED="false"
# Try SMS automatically when WhatsApp delivery fails:
MESSAGING_FALLBACK_TO_SMS="true"

# ── Phase 10: WhatsApp — OPTION A: Meta Business Cloud API ───────
# Two real providers, pick ONE via WHATSAPP_PROVIDER:
#   meta    — official Cloud API (credentials below; no phone pairing)
#   baileys — WhatsApp Web session on your phone (no credentials; see
#             OPTION B at the bottom of this section)
WHATSAPP_PROVIDER="meta"
#
# HOW TO GET THESE VALUES (Meta Business / WhatsApp Cloud API):
#   1. https://developers.facebook.com/apps/ → create or select your Meta App
#   2. Add the "WhatsApp" product to the app
#   3. WhatsApp → API Setup — everything below is read from that page
#
# Access token. Temporary tokens expire in 24h — for anything beyond quick
# testing, create a System User in Meta Business Manager and generate a
# permanent token (whatsapp_business_management permission).
META_WHATSAPP_TOKEN=""
# The Phone Number ID — NOT the phone number itself.
# API Setup → "From" dropdown (a long numeric id).
META_WHATSAPP_PHONE_NUMBER_ID=""
# WhatsApp Business Account ID — top of the API Setup page.
META_WHATSAPP_BUSINESS_ACCOUNT_ID=""
# Any random string you choose — used by Meta to verify webhook ownership.
# Must match the Verify Token entered in the webhook configuration below.
# Example: dentora-webhook-2026
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
META_API_VERSION="v18.0"
# (Baileys sessions are stored in Redis — see OPTION B below; no session path needed)
#
# NOTE: MESSAGING_ENABLED (above) stays "false" until the credentials are
# filled in — the mock provider keeps the pipeline verifiable with zero
# external calls until then.
#
# MESSAGE TEMPLATES (Meta Business Manager → WhatsApp → Message Templates):
# Proactive messages (outside the 24h customer-service window) must use
# pre-approved templates — approval takes 24–48h. Required, language "ar":
#   1. appointment_confirmation  — sent immediately after booking
#   2. appointment_reminder_24h  — sent 24h before the appointment
#   3. appointment_reminder_1h   — sent 1h before the appointment
# Free-form text only works for numbers that messaged the business first
# (24h window) — enough to start testing: message the business number from
# the test phone, then send the test message back to it.
#
# WEBHOOK (delivery + read receipts) → app/api/webhooks/whatsapp:
#   1. WhatsApp → Configuration → Webhooks
#   2. Callback URL: https://<your-public-domain>/api/webhooks/whatsapp
#   3. Verify Token: the META_WHATSAPP_WEBHOOK_VERIFY_TOKEN value above
#   4. Subscribe to: messages, message_deliveries, message_reads
# Requires a PUBLIC https URL (not localhost) — for local testing use e.g.
# ngrok:  ngrok http 3000  →  https://xxxx.ngrok.io/api/webhooks/whatsapp
#
# PHONE NUMBERS: international format without "+" —
# Egypt: 01012345678 → 201012345678.
# RATE LIMITS (basic tier): ~1,000 conversations/day per number, 80 msg/s.
#
# ── Phase 10: WhatsApp — OPTION B: Baileys (WhatsApp Web) ─────────
# For clinics without Meta Business: use an ordinary (or personal) phone
# number as the clinic's WhatsApp sender.
#
#   1. No credentials to configure — the session is a QR scan.
#   2. Start Redis (docker compose up -d redis) — the Baileys session and
#      QR are persisted there (REDIS_URL above).
#   3. Set WHATSAPP_PROVIDER="baileys" (keep MESSAGING_ENABLED="true").
#   4. Open /super-admin/whatsapp in the browser (SUPER_ADMIN login) and
#      scan the QR: WhatsApp → Settings → Linked Devices → Link a Device.
#   5. Test:  npm run whatsapp:test -- 201012345678
#
# The session survives server restarts (stored in Redis) — you scan ONCE.
# QR receipts: the admin Message Log shows SENT/DELIVERED/READ/FAILED
# (Baileys events map to the same delivery columns as the Meta webhook).
#
# ⚠  BAILEYS IS NOT AN OFFICIAL META API. High-volume or bulk/automated
#    sending from a single number can get that number BANNED by Meta.
#    Reserve Baileys for low-volume clinic messaging; use the official
#    Meta Cloud API (OPTION A) for scale.

# SMS provider: twilio | africas_talking | mock
SMS_PROVIDER="twilio"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
AFRICAS_TALKING_API_KEY=""
AFRICAS_TALKING_USERNAME=""
AFRICAS_TALKING_FROM=""

# Fallback clinic identity used in message templates when the hospital
# record does not carry them:
CLINIC_NAME="عيادة دنتورا للأسنان"
CLINIC_ADDRESS=""
CLINIC_PHONE=""
